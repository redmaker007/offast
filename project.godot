; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Offast"
run/main_scene="res://main_game/boot.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="uid://bw2mqkpbtp4re"

[autoload]

SignalBus="*uid://cfucvlfc0a3n3"
SceneTransition="*uid://dy1uutekf1p4u"
RoundState="*uid://btrln84isgbh7"
WindowManager="*uid://cm8x8nwqup0yt"
SaveState="*uid://d06ejkfi6h0ms"
GameState="*res://autoload/game_state.gd"
MCPRuntimeProbe="*uid://bsg12huaf1u5i"
Bgm="*res://addons/bgm/bgm_player.tscn"
AudioSettings="*res://addons/audio_settings/audio_settings.gd"
LocaleSettings="*res://addons/locale_settings/locale_settings.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="ignore"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_mcp/plugin.cfg", "res://addons/ui_polish/plugin.cfg", "res://addons/save_state/plugin.cfg", "res://addons/story_script/plugin.cfg")

[file_customization]

folder_colors={
"res://font/": "green",
"res://sound/": "purple",
"res://theme/": "orange"
}

[gui]

theme/custom_font="res://font/NotoSansSC-Regular.ttf"

[internationalization]

locale/translations=PackedStringArray("res://locale/ui.zh.translation", "res://locale/ui.en.translation")
locale/fallback="zh"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
